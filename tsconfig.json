{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@prisma-zod/*": ["./prisma/generated/zod/*"]
    }
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "tests/**/*",
    "dev/scripts/**/*",
    "scripts/**/*",
    "__mocks__/**/*",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
