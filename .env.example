# Node environement (optional)
# NODE_ENV=development

# API server port (default: 4000)
PORT=4000

# Database connection string
DATABASE_URL=postgres://postgres:convos@convos_db:5432/postgres?sslmode=disable

# Firebase service account
FIREBASE_SERVICE_ACCOUNT=

# XMTP environment
XMTP_ENV=dev

# Thirdweb secret for social profile lookup
THIRDWEB_SECRET_KEY=

# XMTP database encryption key
XMTP_DB_ENCRYPTION_BASE_64_KEY=

# v1 JWT (deprecated)
# JWT_SECRET=your-secure-secret-key-here

# v2 JWT - Asymmetric ECDSA keys (generate with: bun run dev/scripts/generateEcdsaKeys.ts)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Notifications server URL
NOTIFICATION_SERVER_URL=

# Secret for XMTP notification server authentication
XMTP_NOTIFICATION_SECRET=

# Turnkey API base URL
TURNKEY_API_BASE_URL=https://api.turnkey.com

# Public key of the Turnkey API Only User
TURNKEY_API_PUBLIC_KEY=

# Private key of the Turnkey API Only User
TURNKEY_API_PRIVATE_KEY=

# Turnkey Organization ID
TURNKEY_ORGANIZATION_ID=

# Namestone
NAMESTONE_BASE_URL=https://namestone.com/api/public_v1
NAMESTONE_API_KEY=
NAMESTONE_DOMAIN=convosapp.eth|convos.org

# Website URL
WEBSITE_URL=https://popup.convos.org

# APNS - Apple Push Notifications Service
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Assets CDN Base URL
CDN_BASE_URL="https://assets.prod.convos.xyz"
