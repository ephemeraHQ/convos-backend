{
  "name": "convos-backend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "buf:generate": "buf generate",
    "build": "tsup",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint",
    "clean": "rimraf node_modules",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "eval:models": "tsx tests/evals/run.ts",
    "eval:prompt": "tsx tests/evals/compare-prompts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:key": "tsx dev/scripts/generateDbKey.ts",
    "generate:notification-secret": "tsx dev/scripts/generateNotificationSecret.ts",
    "lint": "eslint .",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "start": "node --enable-source-maps --env-file-if-exists=.env --import @opentelemetry/instrumentation/hook.mjs --import ./dist/instrumentation.js dist/index.js",
    "test": "vitest run",
    "test:local": "pnpm prisma migrate reset --force && vitest run",
    "test:notifications-client": "TEST_NOTIFICATION_DELIVERY_URL=http://host.docker.internal:8081 XMTP_NOTIFICATION_SECRET=test-notification-secret dev/restart-notification && vitest run tests/notifications.client.test.ts",
    "test:push": "tsx scripts/test-push-notification.ts",
    "test:push-simple": "tsx scripts/simple-push-test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@composio/core": "^0.6.10",
    "@connectrpc/connect": "^2.0.1",
    "@connectrpc/connect-node": "^2.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-pino": "^0.64.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@posthog/ai": "^7.18.11",
    "@prisma/client": "^6.17.0",
    "@prisma/instrumentation": "^6.7.0",
    "@turnkey/sdk-server": "^3.0.1",
    "@xmtp/node-sdk": "^2.0.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.14.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^2.1.35",
    "openai": "^6.38.0",
    "path-to-regexp": "^8.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "posthog-node": "5.33.3",
    "prisma": "^6.17.0",
    "protobufjs": "^7.5.4",
    "secp256k1": "^5.0.1",
    "siwe": "3.0.0",
    "thirdweb": "^5.88.2",
    "uint8array-extras": "^1.4.0",
    "uuid": "^11.0.5",
    "viem": "^2.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "braintrust": "^3.11.0",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "ethers": "^6.16.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-packagejson": "^2.5.7",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.0.0",
    "zod-prisma-types": "3.2.4"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "@firebase/util",
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "esbuild",
      "keccak",
      "prisma",
      "protobufjs",
      "secp256k1",
      "sharp",
      "utf-8-validate"
    ]
  }
}
